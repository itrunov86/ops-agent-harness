# Шаблон секретов для MCP-сервера.
# Скопируй в .env и заполни. Файл .env в git не коммитится (.gitignore).
# В config.yaml эти переменные подставляются синтаксисом ${VAR}.

# --- Jira (обязательно для jira_* tools) ---
# Personal Access Token. Получить: Jira -> Profile -> Personal Access Tokens -> Create token.
JIRA_PAT=

# --- Confluence (опционально) ---
CONFLUENCE_PAT=

# --- GitLab (опционально) ---
# Personal Access Token. Получить: GitLab -> Profile -> Access Tokens -> Create token.
# scope: 'api' для записи (комментарии в MR и т.п.), 'read_api' для read-only.
GITLAB_PAT=

# --- Mattermost (опционально) ---
# Personal Access Token. Получить: Mattermost -> Account Settings ->
# Security -> Personal Access Tokens (если выключено — обратись к админу,
# System Console -> Integrations -> Personal Access Tokens).
MATTERMOST_PAT=

# --- Grafana (опционально) ---
# Service Account Token. Получить: Grafana UI -> Administration ->
# Service accounts -> создать → New token. Роль Viewer достаточна
# для read-only тулов.
GRAFANA_TOKEN=

# --- Observability stack (опционально, можно оставить пустыми) ---
AM_BEARER_TOKEN=
VM_BEARER_TOKEN=
VL_BEARER_TOKEN=
